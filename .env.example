# Copy to .env and fill in secrets. Injected by Docker Compose.

# ── Model API ────────────────────────────────────────────────
# Credentials injected into the opencode sandbox for agent dispatches.
# At minimum set OPENROUTER_API_KEY.
OPENROUTER_API_KEY=sk-or-...
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ── Observability ────────────────────────────────────────────
# Langfuse tracing credentials, injected into the sandbox.
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...

# ── Platform ─────────────────────────────────────────────────
# Shared orchestrator and sandbox configuration. Applies to all workflows.
BP_LOG_LEVEL=info
BP_OTEL_PORT=4318
BP_MCP_PORT=8001
BP_POLL_INTERVAL=5
BP_PIPELINE_DB_PATH=pipeline_checkpoints.db
BP_SANDBOX_IMAGE=opencode-agent:latest
BP_SANDBOX_RUNTIME=runsc
BP_SKILLS_PATH=.agents/skills

# ── SDD workflow ─────────────────────────────────────────────
# Target repository the SDD agent builds, plus the Redmine project that
# tracks its progress. SDD-specific; unused by other workflows.
# REDMINE_API_KEY is generated by redmine-setup — do not set manually.
BP_TARGET_REPO_PATH=/home/user/projects/my-project
REDMINE_BASE_URL=http://redmine:3000
REDMINE_PROJECT=default
